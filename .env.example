# ============================================================
# NisiClinic CRM — Environment Variables
# ============================================================
#
# If you set this variable (e.g. in your local .env or Netlify Site Settings > Environment Variables),
# every device/laptop will automatically connect to your Google Sheet without needing manual URL entry!
#
# VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
